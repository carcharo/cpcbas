// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compile() dumps > --stage asm prints the linked asm and stops 1`] = `
"	org 64
	.core.CPC_PRIV_BASE EQU 40448
	.core.CPC_PRIV_SIZE EQU 1024
	.core.CPC_STACK_TOP EQU 42496
	.core.CPC_MEM_TOP EQU 42619
.core.__START_PROGRAM:
	di
	ld sp, .core.CPC_STACK_TOP
	call .core.CPC_INIT_00_BOOTSTRAP
	call .core.__MEM_INIT
	jp .core.__MAIN_PROGRAM__
.core.ZXBASIC_USER_DATA:
	; Defines HEAP SIZE
.core.ZXBASIC_HEAP_SIZE EQU 4768
	; Defines HEAP ADDRESS
.core.ZXBASIC_MEM_HEAP EQU 35680
	; Defines USER DATA Length in bytes
.core.ZXBASIC_USER_DATA_LEN EQU .core.ZXBASIC_USER_DATA_END - .core.ZXBASIC_USER_DATA
	.core.__LABEL__.ZXBASIC_USER_DATA_LEN EQU .core.ZXBASIC_USER_DATA_LEN
	.core.__LABEL__.ZXBASIC_USER_DATA EQU .core.ZXBASIC_USER_DATA
_x:
	DEFB 00, 00
.core.ZXBASIC_USER_DATA_END:
.core.__MAIN_PROGRAM__:
	ld hl, 1
	call .core.__LOCO_PRINTI16
	call .core.__LOCO_NL
	ld hl, 2
	ld (_x), hl
	ld hl, 0
	ld b, h
	ld c, l
.core.__END_PROGRAM:
	jp .core.__CPC_END
	;; --- end of user code ---
#include once <bootstrap.asm>
#include once <loco/number.asm>
#include once <loco/txtout.asm>
	END .core.__START_PROGRAM
"
`;

exports[`compile() dumps > --stage ir prints the IR and stops 1`] = `
"main
  ; stmt
  fparam.i16 #1
  rtcall .core.__LOCO_PRINTI16
  rtcall .core.__LOCO_NL
  ; stmt
  store.i16 _x, #2
  end #0

global _x i16 size=2
"
`;
