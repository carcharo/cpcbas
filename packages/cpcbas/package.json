{
  "name": "@cpcbuild/cpcbas",
  "version": "0.2.0-dev",
  "description": "CPC BASIC compiler for the Amstrad CPC: pure TypeScript library and command-line tool",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "default": "./dist/src/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cpcbas": "./dist/bin/cpcbas.js"
  },
  "files": [
    "dist/src",
    "dist/bin",
    "dist/lib",
    "dist/cpcbas.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tools/copy-lib.mjs",
    "bundle": "node ../../tools/bundle.mjs",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.json --noEmit"
  }
}
