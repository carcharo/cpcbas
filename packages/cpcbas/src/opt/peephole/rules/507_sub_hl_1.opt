;; cpcbas L5-PEEP: our own rule (docs/ir.md "The rule files").

;; ld de, 1
;; ld hl, X
;; or a
;; sbc hl, de
;;
;; With:
;; ld hl, X
;; dec hl
;;
;; The subtraction of 504-506's addition (variable - constant). DE and the flags are dead after the
;; quad's subtraction ($00: sub:u16 and sub:i16).

OLEVEL: 1
OFLAG: 507

REPLACE {{
  ld de, 1
  ld hl, $1
  or a
  sbc hl, de
}}

IF {{
  !IS_REG16($1) && ($00 IN ("sub:u16", "sub:i16"))
}}

WITH {{
  ld hl, $1
  dec hl
}}
