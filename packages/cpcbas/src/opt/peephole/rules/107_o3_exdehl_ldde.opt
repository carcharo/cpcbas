;; Ported from zxbasic src/arch/z80/peephole/opts/107_o3_exdehl_ldde.opt at e33cf0cd (cpcbas L5-PEEP; changes: none; OLEVEL 3/4, kept as data for L5-FLOW and never run by the peephole pass).

;; Replaces
;;
;; ld hl, nn
;; ex de, hl
;;
;; With
;; ld de, nn
;;
;; if hl is no longer required

OLEVEL: 3
OFLAG: 107

REPLACE {{
  ld hl, $1
  ex de, hl
}}

IF {{
    !IS_REQUIRED(hl)
}}

WITH {{
  ld de, $1
}}
