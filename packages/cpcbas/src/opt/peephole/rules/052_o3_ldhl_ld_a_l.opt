;; Ported from zxbasic src/arch/z80/peephole/opts/052_o3_ldhl_ld_a_l.opt at e33cf0cd (cpcbas L5-PEEP; changes: none; OLEVEL 3/4, kept as data for L5-FLOW and never run by the peephole pass).

;; Replaces sequence:
;; ld hl, (_XXXX)
;; ld a, l
;;
;; With:
;; ld a, (_XXXX)

OLEVEL: 3
OFLAG: 52

REPLACE {{
 ld hl, ($1)
 ld a, l
}}

IF {{
  !IS_REQUIRED(hl)
}}

WITH {{
 ld a, ($1)
}}
