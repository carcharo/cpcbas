;; Ported from zxbasic src/arch/z80/peephole/opts/103_o3_or_and_a.opt at e33cf0cd (cpcbas L5-PEEP; changes: none; OLEVEL 3/4, kept as data for L5-FLOW and never run by the peephole pass).

;; Removes useless AND, OR a

OLEVEL: 3
OFLAG: 103

REPLACE {{
  $1 $2
}}

IF {{
  ($1 IN (and, or)) &&
  (($2 == a) || (!IS_REQUIRED(a))) &&
  !IS_REQUIRED(f)
}}

WITH {{
}}
