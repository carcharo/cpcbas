;; Replaces sequence:
;;  jp XXX
;;  XXX:
;; with
;;  XXX:
;; (jp is useless here)

OLEVEL: 1
OFLAG: 4

REPLACE {{
 jp$1 $2
 $2:
}}

WITH {{
 $2:
}}
