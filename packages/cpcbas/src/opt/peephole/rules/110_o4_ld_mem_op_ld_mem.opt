;; Ported from zxbasic src/arch/z80/peephole/opts/110_o4_ld_mem_op_ld_mem.opt at e33cf0cd (cpcbas L5-PEEP; changes: none; OLEVEL 3/4, kept as data for L5-FLOW and never run by the peephole pass).

;; Removes useless LD's
;; Tries to guess the value of the 1st and 2nd operands.
;; If they're the same, this LD is useless

OLEVEL: 4
OFLAG: 110

REPLACE {{
  $1 $2
}}

IF {{
 ((($1 == inc || $1 == dec) && !IS_REQUIRED($2))
 || ($1 == sub && !IS_REQUIRED(a))
 ) && ($2 <> sp) && !IS_REQUIRED(f)
}}

WITH {{
}}
