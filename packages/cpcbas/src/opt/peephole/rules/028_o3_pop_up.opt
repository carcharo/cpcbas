;; Ported from zxbasic src/arch/z80/peephole/opts/028_o3_pop_up.opt at e33cf0cd (cpcbas L5-PEEP; changes: none; OLEVEL 3/4, kept as data for L5-FLOW and never run by the peephole pass).

;; Replace sequence:
;; <instruction>
;; pop rr
;;
;; With:
;; pop rr
;; <instruction>
;;
;; This frees the stack ASAP and hopefully clash against a PUSH

OLEVEL: 3
OFLAG: 28

REPLACE {{
  $2
  pop $1
}}

IF {{
  !(INSTR($2) IN (jp, jr, ret, call, djnz, rst)) && !NEEDS($2, (sp, $1)) && !IS_LABEL($2)
  && OP1($2) <> "sp"
}}

WITH {{
  pop $1
  $2
}}
