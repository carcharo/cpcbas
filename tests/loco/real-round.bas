10 DEFREAL a-z
20 REM ROUND(x, n): the measured rows (probes p-round, p-round2), text and bytes
30 READ m:FOR k=1 TO m:READ x,d:a=ROUND(x,d):PRINT x;d;:GOSUB 100:NEXT
