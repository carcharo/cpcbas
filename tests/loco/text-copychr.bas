10 REM L4-TEXT: COPYCHR$ (BASIC 1.1: the 6128 only; the 464 has no COPYCHR$)
20 MODE 1:PAPER 0:PEN 1:CLS
30 PRINT "Hello";
40 LOCATE 1,1:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$);ASC(c$)
50 LOCATE 5,1:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$);ASC(c$)
60 LOCATE 6,1:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$);ASC(c$)
70 LOCATE 20,10:PRINT CHR$(200);:LOCATE 20,10:c$=COPYCHR$(#0):PRINT LEN(c$);ASC(c$)
80 LOCATE 22,10:PRINT CHR$(207);:LOCATE 22,10:c$=COPYCHR$(#0):PRINT LEN(c$);ASC(c$)
90 SYMBOL 250,1,2,4,8,16,32,64,128
100 LOCATE 24,10:PRINT CHR$(250);:LOCATE 24,10:c$=COPYCHR$(#0):PRINT LEN(c$);ASC(c$)
110 WINDOW #2,1,10,20,25:PAPER #2,0:PEN #2,1:CLS #2:PRINT #2,"Zed";
120 LOCATE #2,1,1:PRINT COPYCHR$(#2);COPYCHR$(#2)
130 LOCATE #2,2,1:d$=COPYCHR$(#2):PRINT d$;ASC(d$);POS(#2);VPOS(#2)
140 PRINT LEN(COPYCHR$(#0)+COPYCHR$(#2))
150 PAPER 2:LOCATE 1,1:c$=COPYCHR$(#0):PRINT "unreadable:";LEN(c$)
160 PAPER 0
170 e$="":FOR i=1 TO 5:LOCATE i,1:e$=e$+COPYCHR$(#0):NEXT:PRINT e$
