10 DEFREAL a-z
20 REM SQR EXP LOG LOG10 SIN COS TAN ATN and ^ at several arguments, RAD and DEG: text and bytes
30 READ n:DIM v(20):FOR k=1 TO n:READ v(k):NEXT
40 FOR k=1 TO n
50 x=v(k):PRINT "x=";x
60 IF x>=0 THEN a=SQR(x):GOSUB 500:PRINT " SQR";:GOSUB 600
70 IF x<=88 AND x>=-80 THEN a=EXP(x):PRINT " EXP";:GOSUB 600
80 IF x>0 THEN a=LOG(x):PRINT " LOG";:GOSUB 600:a=LOG10(x):PRINT " LOG10";:GOSUB 600
90 a=ATN(x):PRINT " ATN";:GOSUB 600
100 IF ABS(x)<=100000 THEN a=SIN(x):PRINT " SIN";:GOSUB 600:a=COS(x):PRINT " COS";:GOSUB 600:a=TAN(x):PRINT " TAN";:GOSUB 600
110 NEXT
120 DEG
130 PRINT "DEG"
140 FOR k=1 TO n
150 x=v(k)
160 IF ABS(x)<=100000 THEN a=SIN(x):PRINT "x=";x;" SIN";:GOSUB 600:a=COS(x):PRINT " COS";:GOSUB 600:a=TAN(x):PRINT " TAN";:GOSUB 600
170 a=ATN(x):PRINT " ATN";:GOSUB 600
180 NEXT
190 RAD
200 PRINT "POW"
210 READ m:FOR k=1 TO m:READ x,y:a=x^y:PRINT x;y;:GOSUB 600:NEXT
220 END
500 RETURN
600 PRINT a;":";
610 IF PEEK(@a+4)=0 THEN PRINT:RETURN
620 FOR i=0 TO 4:PRINT HEX$(PEEK(@a+i),2);:NEXT
630 PRINT:RETURN
700 DATA 20
710 DATA 0.5,1,2,3,10,0.1,100,1E-5,45,89,180,0.001,7.5,1234.5678,1E5,25,16,0.25,-1.5,-45
720 DATA 14
730 DATA 2,0.5, 2,10, 10,-2, 3,3.5, 0.5,0.5, 1.5,-2.5, 7,2, -2,3, -2,-3, 100,0.5, 1E10,0.1, 5,0, 0,5, 2,-0.5
