10 DEFREAL a-z
20 REM VAL of numeric texts: the REAL it makes (text and bytes)
30 READ n:FOR k=1 TO n:READ s$:a=VAL(s$):PRINT "[";s$;"]";:GOSUB 100:NEXT
40 END
100 PRINT a;":";
110 IF PEEK(@a+4)=0 THEN PRINT:RETURN
120 FOR i=0 TO 4:PRINT HEX$(PEEK(@a+i),2);:NEXT
130 PRINT:RETURN
200 DATA 24
210 DATA 1,-1,0.5,1.5,2.5E3,-2.5E-3,0.1,0.2,0.3,3.14159265,123456789,1234567890,12345678901
220 DATA 1E10,1E-10,1E38,1E-38,.5,5.,100,0.30000001,16777217,1.7014118E38,abc
