10 DEFREAL a-z
20 REM RANDOMIZE n then RND: the firmware's generator (Locomotive's sequence exactly)
30 FOR s=1 TO 4
40 READ n:RANDOMIZE n
50 PRINT "seed";n
60 FOR k=1 TO 12:a=RND:GOSUB 300:NEXT
70 a=RND(0):PRINT " last";:GOSUB 300
80 NEXT
90 RANDOMIZE 7:a=RND(-7):PRINT "RND(-7)";:GOSUB 300
100 a=RND(1):GOSUB 300
110 a=RND(0):GOSUB 300
120 RANDOMIZE 100:FOR k=1 TO 50:a=RND:NEXT:PRINT "50th";:GOSUB 300
130 END
300 PRINT a;":";
310 FOR i=0 TO 4:PRINT HEX$(PEEK(@a+i),2);:NEXT
320 PRINT:RETURN
330 DATA 7,100,3,1000
