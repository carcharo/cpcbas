10 REM timers: EVERY, AFTER, REMAIN, DI, EI, priorities, TIME
20 REM waits use TIME (1/300 s), never counted loops, so the interpreter and the compiled program agree
30 REM the firmware ticker ignores tickers for about 0.6 s after the disc load (measured on both emulators): wait first
40 w=300:GOSUB 900
100 PRINT "A: EVERY and AFTER"
110 n=0:m=0
120 EVERY 10,1 GOSUB 1000
130 w=250:GOSUB 900
140 r=REMAIN(1)
150 PRINT n;r>0 AND r<=10;REMAIN(1)
160 AFTER 15,2 GOSUB 1100
170 w=150:GOSUB 900
180 PRINT m;REMAIN(2)
190 EVERY 5,3 GOSUB 1000
200 AFTER 1000,3 GOSUB 1100
210 n=0:m=0:w=100:GOSUB 900
220 PRINT n;m;REMAIN(3)>900
230 EVERY 5,3 GOSUB 1000
240 EVERY 0,3 GOSUB 1000
250 w=100:GOSUB 900
260 PRINT n;REMAIN(3)
300 PRINT "B: priorities"
310 AFTER 5,0 GOSUB 2000
320 AFTER 10,1 GOSUB 2100
330 AFTER 15,3 GOSUB 2200
340 AFTER 20,2 GOSUB 2300
350 w=250:GOSUB 900
360 PRINT "main done"
400 PRINT "C: DI and EI"
410 n=0:EVERY 10,0 GOSUB 1000
420 DI
430 w=150:GOSUB 900
440 PRINT n
450 EI
460 PRINT n
470 r=REMAIN(0)
500 PRINT "D: DI in a handler, RETURN enables"
510 AFTER 5,0 GOSUB 3000
520 w=150:GOSUB 900
530 AFTER 5,1 GOSUB 3100
540 w=150:GOSUB 900
600 PRINT "E: TIME"
610 t1=TIME:w=60:GOSUB 900:d=TIME-t1
620 PRINT d>=60
630 PRINT "~";d
640 PRINT "end"
650 END
900 t0=TIME:WHILE TIME-t0<w:WEND:RETURN
1000 n=n+1:RETURN
1100 m=m+1:RETURN
2000 PRINT "t0 start":u0=TIME:WHILE TIME-u0<150:WEND:PRINT "t0 end":RETURN
2100 PRINT "t1 start":u1=TIME:WHILE TIME-u1<70:WEND:PRINT "t1 end":RETURN
2200 PRINT "t3 start":u3=TIME:WHILE TIME-u3<20:WEND:PRINT "t3 end":RETURN
2300 PRINT "t2 start":u2=TIME:WHILE TIME-u2<20:WEND:PRINT "t2 end":RETURN
3000 PRINT "d0 start":DI:AFTER 3,3 GOSUB 3200:v0=TIME:WHILE TIME-v0<90:WEND:PRINT "d0 end":RETURN
3100 PRINT "d1 start":EI:PRINT "d1 end":RETURN
3200 PRINT "t3 start":PRINT "t3 end":RETURN
