10 REM L4-TEXT: windows, streams #0-#7, WINDOW SWAP, POS/VPOS per stream, TAG
20 REM LOCO: shot
30 MODE 1:PAPER 0:PEN 1:CLS
40 WINDOW #1,3,20,3,8
50 WINDOW #2,23,38,3,8
60 PAPER #1,2:PEN #1,3:CLS #1
70 PAPER #2,3:PEN #2,1:CLS #2
80 PRINT #1,"Window one";
90 PRINT #2,"Two"
100 PRINT "main";POS(#0);VPOS(#0);POS(#1);VPOS(#1);POS(#2);VPOS(#2)
110 REM a window is a window: cursor, scrolling, width
120 FOR i=1 TO 8:PRINT #1,"line";i:NEXT
130 PRINT "after the scroll";POS(#1);VPOS(#1)
140 LOCATE #2,5,3:PRINT #2,"at 5,3";POS(#2);VPOS(#2)
150 PRINT #2,"this is longer than the window"
160 PRINT #2,12345678;1;2
170 PRINT #1,"a","b"
180 PRINT #1,TAB(10);"t";TAB(3);"u"
190 WINDOW SWAP 1,2
200 PRINT #1,"swap1";POS(#1);VPOS(#1)
210 PRINT #2,"swap2";POS(#2);VPOS(#2)
220 WINDOW SWAP 1,2
230 REM stream 0 as a window
240 WINDOW 5,35,12,20
250 PAPER 1:PEN 0:CLS
260 PRINT "in zero";POS(#0);VPOS(#0)
270 PRINT "a","b","c"
280 PRINT TAB(20);"x";POS(#0)
290 PRINT STRING$(40,"z");POS(#0);VPOS(#0)
300 FOR i=1 TO 12:PRINT i;:NEXT
310 PRINT
320 WINDOW 1,40,22,25
330 PAPER 2:CLS
340 PRINT "bottom";POS(#0);VPOS(#0)
350 WINDOW #3,1,10,10,11:PAPER #3,0:PEN #3,1:CLS #3:PRINT #3,"three";POS(#3);VPOS(#3)
360 WINDOW #4,11,20,10,11:PAPER #4,3:PEN #4,0:CLS #4:PRINT #4,"four"
370 WINDOW #7,21,30,10,11:PAPER #7,1:PEN #7,2:CLS #7:PRINT #7,"seven";POS(#7)
380 TAG:PRINT "tagged";:TAGOFF
390 TAG #1:PRINT #1,"t1";:TAGOFF #1
400 PRINT "end";POS(#0);VPOS(#0)
