10 REM control flow
20 FOR i=1 TO 3
30 IF i=2 THEN PRINT "two" ELSE PRINT "not two";i
40 NEXT
50 FOR i=1 TO 3:IF i<3 THEN 70
60 PRINT "i is";i
70 NEXT
80 n=0
90 WHILE n<4
100 n=n+1:IF n=2 THEN 120
110 PRINT "n";n
120 WEND
130 GOSUB 500
140 PRINT "back"
150 FOR k=0 TO 4
160 ON k GOTO 200,210,220
170 PRINT "fell";k
180 GOTO 230
200 PRINT "one":GOTO 230
210 PRINT "two":GOTO 230
220 PRINT "three"
230 NEXT k
240 FOR k=0 TO 4
250 ON k GOSUB 600,610
260 NEXT
270 FOR i=10 TO 1 STEP -4:PRINT i;:NEXT:PRINT
280 FOR i=1 TO 10 STEP 3:PRINT i;:NEXT:PRINT
290 FOR i=1 TO 2:FOR j=1 TO 3:PRINT i*10+j;:NEXT j,i:PRINT
300 FOR i=3 TO 1 STEP -1:PRINT i;:NEXT:PRINT
310 GOTO 700
500 PRINT "sub":RETURN
600 PRINT "gosub one":RETURN
610 PRINT "gosub two":RETURN
700 x=5
710 IF x>3 THEN IF x>4 THEN PRINT "big" ELSE PRINT "mid" ELSE PRINT "small"
720 IF x<3 THEN PRINT "small" ELSE IF x<6 THEN PRINT "five-ish" ELSE PRINT "large"
730 n=3
740 WHILE n>0:m=n:WHILE m>0:PRINT m;:m=m-1:WEND:PRINT:n=n-1:WEND
750 END
