10 REM REAL number text, ported from the method of cpcbuild's floatfmt (follow-up 145). Locomotive's rules, blessed on the
20 REM interpreter: 9 significant digits rounded, fixed notation or E+xx, the limits, and VAL(STR$(x)) round trips.
30 MODE 2:DEFREAL a-d:c=1:d=3
40 REM --- literals in the source: STR$ and the round trip
50 a=0:GOSUB 900:a=1:GOSUB 900:a=-1:GOSUB 900:a=0.5:GOSUB 900:a=-0.5:GOSUB 900
60 a=c/d:GOSUB 900:a=2*c/d:GOSUB 900:a=-c/d:GOSUB 900:a=c/7:GOSUB 900
70 a=123456789:GOSUB 900:a=1234567890:GOSUB 900:a=12345678:GOSUB 900:a=99999999:GOSUB 900
80 a=100000000:GOSUB 900:a=999999999:GOSUB 900:a=1E9:GOSUB 900:a=1E10:GOSUB 900:a=1E13:GOSUB 900
90 a=1E15:GOSUB 900:a=1E38:GOSUB 900:a=1.7E38:GOSUB 900:a=1.7014118E38:GOSUB 900
100 a=1E-5:GOSUB 900:a=1E-6:GOSUB 900:a=1.5E-10:GOSUB 900:a=1E-38:GOSUB 900:a=2.9387359E-39:GOSUB 900
110 a=0.0001:GOSUB 900:a=0.00001:GOSUB 900:a=0.001:GOSUB 900:a=0.0123456789:GOSUB 900
120 a=3.14159265:GOSUB 900:a=-3.14159265*1E20:GOSUB 900:a=0.99999999:GOSUB 900:a=0.999999999:GOSUB 900
130 a=9.9999999E9:GOSUB 900:a=9.99999995E9:GOSUB 900:a=123456.789:GOSUB 900:a=0.1:GOSUB 900:a=0.2+0.1:GOSUB 900
140 a=1.5E-5:GOSUB 900:a=1.23E-7:GOSUB 900:a=5E-5:GOSUB 900:a=65535:GOSUB 900:a=-65536:GOSUB 900
150 a=4294967295:GOSUB 900:a=2147483648:GOSUB 900:a=2147483647:GOSUB 900:a=-2147483648:GOSUB 900
160 REM --- the 9-digit rounding
170 a=1.23456789:GOSUB 900:a=1.234567895:GOSUB 900:a=1.2345678949:GOSUB 900:a=0.123456789012:GOSUB 900
180 a=99999999.5:GOSUB 900:a=999999999.5:GOSUB 900:a=9999999999.5:GOSUB 900:a=0.000123456789:GOSUB 900
190 a=1234567.89123:GOSUB 900:a=12345678.9123:GOSUB 900:a=123456789.123:GOSUB 900:a=1234567891.23:GOSUB 900
200 a=2.5:GOSUB 900:a=0.15:GOSUB 900:a=0.35:GOSUB 900:a=1.005:GOSUB 900:a=16777217:GOSUB 900
210 REM --- the switch to E+xx and E-xx: powers of ten and of two
220 FOR k=-12 TO 16:a=10^k:PRINT k;:GOSUB 900:NEXT
230 FOR k=-4 TO 4:a=1.5*10^k:PRINT k;:GOSUB 900:a=-9.87654321*10^(k*3):PRINT k;:GOSUB 900:NEXT
240 FOR k=0 TO 117 STEP 13:a=2^k:PRINT k;:GOSUB 900:NEXT
250 REM --- VAL of texts, from DATA, then the number's own text
260 READ n:FOR k=1 TO n:READ s$:a=VAL(s$):PRINT "[";s$;"] ";:GOSUB 900:NEXT
270 REM --- the numbers that come from DATA are numbers
280 READ n:FOR k=1 TO n:READ a:PRINT "D";:GOSUB 900:NEXT
290 REM --- PRINT of a number directly, in lists
300 PRINT 1E9;1E10;123456789;1.23456789E9;1.2345678901E10;1E15;1E-9;0.00001234
310 PRINT 100000;1E5;12345.678;-0.000001;c/d;-2*c/d;1E38;1.7E38;1E-38
320 PRINT 0.1+0.2;0.3-0.1;1-0.9;1E10+1;1E10-1;(1E8-1)+1;99999999.4+1
330 END
900 t$=STR$(a):b=VAL(t$):PRINT "[";t$;"] [";STR$(b);"] ";:IF STR$(b)=t$ THEN PRINT "=" ELSE PRINT "<>"
910 RETURN
1000 DATA 36
1010 DATA 1,-1,.5,5.,1E5,1E+5,1e5,1E-5,"  12  ","+7",1.5E3,123456789012,0.000001234,1.7E38
1020 DATA 1.7014118E38,1E-38,-0,0.1,0.30000001,16777217,100,1E10,1E-10,1234567890123456789
1030 DATA 12.5E1,.5E+1,3.14159265358979,-3.14159265E20,2.5E-3,0.99999999999,9.99999995E9,12abc,abc,""
1040 DATA 1E,1E+
1100 DATA 12
1110 DATA 1,-1,0.5,1.5,2.5E3,-2.5E-3,0.1,0.2,0.3,3.14159265,123456789,1234567890
