10 REM LOCO: shot
20 REM ORIGIN (with and without a window), CLG, the graphics cursor after each, MODE resetting them
30 MODE 1
40 ORIGIN 200,200: PLOT 5,5,1: MODE 1: PRINT XPOS;YPOS
50 PLOT 0,0,1: PRINT TEST(0,0);TEST(-60,-60);TEST(300,300);XPOS;YPOS
60 ORIGIN 200,200: MODE 2: PRINT XPOS;YPOS
70 MODE 1: PLOT 640,0,2: PRINT TEST(640,0);TEST(639,0);TEST(0,0)
80 ORIGIN 100,100: PRINT XPOS;YPOS
90 PLOT 0,0,1: DRAW 200,0,2: DRAW 200,150,3: DRAW 0,150,1: DRAW 0,0,2
100 PRINT TEST(0,0);TEST(-1,0);TEST(100,0);TEST(200,150);XPOS;YPOS
110 ORIGIN 300,200,250,450,150,260
120 PRINT XPOS;YPOS
130 CLG 2: PRINT XPOS;YPOS;TEST(0,0);TEST(-50,0);TEST(-51,0);TEST(150,0);TEST(151,0);TEST(0,60);TEST(0,61)
140 PRINT TEST(-60,-60);TEST(160,70);XPOS;YPOS
150 PLOT -49,-49,3: PLOT -52,-49,1: DRAW 160,50,1: PRINT TEST(-49,-49);TEST(-52,-49)
160 MOVE -100,-40: DRAW 200,-40,3: DRAW 200,40,1
170 ORIGIN 20,30,0,300,100,0
180 CLG: PRINT XPOS;YPOS;TEST(0,0);TEST(5,5)
190 MOVE 0,0: DRAW 280,60,2
200 ORIGIN 0,0,0,639,399,0
210 FOR i=0 TO 399 STEP 40: MOVE 0,i: DRAW 639,i,1: NEXT
220 ORIGIN 320,200
230 FOR i=-300 TO 300 STEP 60: MOVE 0,0: DRAW i,190,2: MOVE 0,0: DRAW i,-190,3: NEXT
240 ORIGIN 500,100,400,600,50,150
250 CLG 1
260 MOVE -50,-30: DRAW 80,60,3
270 LOCATE 1,25: PRINT "origin done";
