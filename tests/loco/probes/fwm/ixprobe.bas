10 MEMORY &7FFF
20 DEFINT i,b
30 FOR i=0 TO 25:READ b:POKE &8000+i,b:NEXT
40 DIM x(4),y(4):FOR i=0 TO 4:READ x(i):NEXT:FOR i=0 TO 4:READ y(i):NEXT
45 IF PEEK(&BDC4)=0 THEN s=&BD61:t=&BDB5 ELSE s=&BD3D:t=&BD91
50 FOR e=s TO t STEP 3
60 FOR i=0 TO 4:POKE &8100+i,x(i):POKE &8108+i,y(i):NEXT
70 POKE &800D,e AND 255:POKE &800E,((e AND &FF00)\256) AND 255
80 CALL &8000
90 PRINT HEX$(e,4);" IX=";HEX$(PEEK(&8207),2);HEX$(PEEK(&8206),2);" ";
100 NEXT
110 PRINT:END
500 DATA &DD,&E5,&DD,&21,&34,&12,&21,0,&81,&11,8,&81,&CD,0,0,&DD,&22,6,&82,&DD,&E1,&C9,0,0,0,0
510 DATA 0,0,0,&40,&81
520 DATA 0,0,0,&10,&82
