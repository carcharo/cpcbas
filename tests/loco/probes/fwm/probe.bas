10 MEMORY &7FFF
20 DEFINT i,b
30 FOR i=0 TO 24:READ b:POKE &8000+i,b:NEXT
40 DIM x(4),y(4):FOR i=0 TO 4:READ x(i):NEXT:FOR i=0 TO 4:READ y(i):NEXT
50 IF PEEK(&BDC4)=0 THEN s=&BD5E:t=&BDC1 ELSE s=&BD3A:t=&BDCA
60 FOR e=s+3 TO t STEP 3
70 FOR i=0 TO 4:POKE &8100+i,x(i):POKE &8108+i,y(i):NEXT
80 POKE &8007,e AND 255:POKE &8008,((e AND &FF00)\256) AND 255
90 PRINT HEX$(e,4);" ";
100 CALL &8000
110 FOR i=0 TO 4:PRINT HEX$(PEEK(&8100+i),2);:NEXT:PRINT " ";
120 FOR i=0 TO 4:PRINT HEX$(PEEK(&8108+i),2);:NEXT:PRINT " ";
130 PRINT HEX$(PEEK(&8201),2);HEX$(PEEK(&8200),2);" ";HEX$(PEEK(&8203),2);HEX$(PEEK(&8202),2);" A";HEX$(PEEK(&8205),2);" F";HEX$(PEEK(&8204),2)
140 NEXT
150 END
