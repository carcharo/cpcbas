5 REM LOCO: cap32
10 ON ERROR GOTO 900:SAVE "B1",B,&C000,16:OPENOUT "T9":PRINT #9,"K":CLOSEOUT
20 OPENOUT "T0":PRINT #9,"X"
30 CHAIN "NOPE":PRINT "H";:PRINT #9,"Z"
40 PRINT "A";:CLOSEOUT
50 PRINT "R";:OPENIN "T0":LINE INPUT #9,A$:PRINT A$:CLOSEIN
60 OPENOUT "T1":PRINT #9,"Y":LOAD "B1",&C000:PRINT "L";:PRINT #9,"W":CLOSEOUT
70 PRINT "R2";:OPENIN "T1":LINE INPUT #9,A$:PRINT A$:CLOSEIN
80 OPENOUT "T3":PRINT #9,"Q":OPENIN "T9":CAT:PRINT "C";:PRINT #9,"V":CLOSEOUT:PRINT "C3";:OPENIN "T3":LINE INPUT #9,A$:PRINT A$:CLOSEIN
90 OPENIN "T9":SAVE "B2",B,&C000,16:PRINT "S";:LINE INPUT #9,A$:PRINT A$:CLOSEIN
150 END
900 PRINT " ERR";ERR;"LINE";ERL:RESUME NEXT
