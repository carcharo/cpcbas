5 REM LOCO: cap32
10 ON ERROR GOTO 900
20 SAVE "B1",B,&C000,16
30 OPENOUT "T0":PRINT #9,"X":CLOSEOUT
40 OPENIN "T0":LOAD "B1",&C000:PRINT "L";:LINE INPUT #9,A$:PRINT A$:CLOSEIN
50 OPENIN "T0":CAT:PRINT "C";:LINE INPUT #9,A$:PRINT A$:CLOSEIN
60 OPENIN "T0":CHAIN "NOPE":PRINT "H";:LINE INPUT #9,A$:PRINT A$:CLOSEIN
70 OPENOUT "T1":PRINT #9,"Y":SAVE "B2",B,&C000,16:PRINT "S";:PRINT #9,"Z":CLOSEOUT
80 PRINT "T1";:OPENIN "T1":LINE INPUT #9,A$:PRINT A$:CLOSEIN
90 OPENOUT "T2":PRINT #9,"Y":CAT:PRINT #9,"Z":CLOSEOUT:PRINT "T2";:OPENIN "T2":LINE INPUT #9,A$:PRINT A$:CLOSEIN
150 END
900 PRINT " ERR";ERR;"LINE";ERL:RESUME NEXT
