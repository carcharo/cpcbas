10 ON ERROR GOTO 1000
20 e=0:EVERY 0 GOSUB 500:PRINT "every0",e
30 e=0:AFTER 0 GOSUB 500:PRINT "after0",e
40 e=0:AFTER -1 GOSUB 500:PRINT "after-1",e
50 e=0:AFTER 32767 GOSUB 500:PRINT "after32767",e,REMAIN(0)
60 e=0:AFTER 32768 GOSUB 500:PRINT "after32768",e
70 e=0:AFTER 65535 GOSUB 500:PRINT "after65535",e
80 e=0:AFTER 100,4 GOSUB 500:PRINT "t4",e
90 e=0:AFTER 100,-1 GOSUB 500:PRINT "t-1",e
100 e=0:PRINT REMAIN(4):PRINT "r4",e
110 e=0:PRINT REMAIN(-1):PRINT "r-1",e
120 e=0:AFTER 100,3 GOSUB 500:PRINT "ok3",e,REMAIN(3),REMAIN(3)
130 e=0:AFTER 1.6 GOSUB 500:PRINT "a1.6",e,REMAIN(0)
140 e=0:AFTER 100,1.6 GOSUB 500:PRINT "t1.6",e,REMAIN(1),REMAIN(2)
150 e=0:AFTER 100,0.4 GOSUB 500:PRINT "t0.4",e,REMAIN(0)
160 PRINT "n=";n
170 END
500 n=n+1
510 RETURN
1000 e=ERR:PRINT "err";ERR;ERL:RESUME NEXT
