10 MODE 1
15 FOR r=26 TO 255 STEP 1
20 LOCATE 5,r:p=POS(#0):v=VPOS(#0):LOCATE 1,1
30 IF v<>25 OR p<>5 THEN PRINT r;p;v;
40 NEXT
50 PRINT:PRINT "full done"
60 WINDOW #1,10,20,5,10
70 FOR r=7 TO 255 STEP 1
80 LOCATE #1,5,r:p=POS(#1):v=VPOS(#1)
90 IF v<>6 OR p<>5 THEN PRINT r;p;v;
100 NEXT
110 PRINT:PRINT "win done"
