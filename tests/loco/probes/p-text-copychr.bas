10 MODE 1
20 ON ERROR GOTO 1000
30 CLS:PRINT "Hello";
40 LOCATE 1,1:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$);ASC(c$)
50 LOCATE 6,1:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$)
60 LOCATE 20,10:PRINT CHR$(255);:LOCATE 20,10:c$=COPYCHR$(#0):PRINT "[";c$;"]";LEN(c$)
70 LOCATE 1,12:PRINT CHR$(200);:LOCATE 1,12:c$=COPYCHR$(#0):PRINT LEN(c$);ASC(c$)
75 LOCATE 1,14:PRINT CHR$(143);:LOCATE 1,14:c$=COPYCHR$(#0):PRINT LEN(c$);ASC(c$)
80 WINDOW #2,1,10,20,25:CLS #2:PRINT #2,"Zed";:LOCATE #2,1,1:PRINT COPYCHR$(#2)
85 PRINT COPYCHR$(#8)
90 PRINT COPYCHR$(#9)
92 PRINT COPYCHR$(#10)
94 PRINT COPYCHR$(#-1)
1000 PRINT "err";ERR;"line";ERL
1010 RESUME NEXT
