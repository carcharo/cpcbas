5 REM FWM-0: SET ANGLE MODE (A=0 RAD, else DEG; the flag is at state+19) and SIN in both modes
1 MEMORY &7FFF:DEFINT a-z:MODE 2
2 FOR i=0 TO 70:READ b:POKE &8000+i,b:NEXT
3 POKE &8208,&78:POKE &8209,&56:POKE &820A,&BC:POKE &820B,&9A
4 bc=&1234:de=&8108:hl=&8100:ra=0:GOTO 10
7999 END
8000 POKE &8023,e AND 255:POKE &8024,((e AND &FF00)\256) AND 255
8001 POKE &8200,bc AND 255:POKE &8201,((bc AND &FF00)\256) AND 255
8002 POKE &8202,de AND 255:POKE &8203,((de AND &FF00)\256) AND 255
8003 POKE &8204,hl AND 255:POKE &8205,((hl AND &FF00)\256) AND 255
8004 POKE &8206,ra:CALL &8000:RETURN
8100 FOR k=0 TO n-1:PRINT RIGHT$("0"+HEX$(PEEK(ad+k)),2);:NEXT:RETURN
9000 DATA 221,229,253,229,237,115,240,128,49,0,144,221,42,8,130,253,42,10,130,237
9001 DATA 75,0,130,237,91,2,130,42,4,130,58,6,130,183,205,0,0,237,67,32
9002 DATA 130,237,83,34,130,34,36,130,245,225,34,38,130,221,34,40,130,253,34,42
9003 DATA 130,237,123,240,128,253,225,221,225,201,201
9 DIM a0(4),a1(4),a2(4)
10 e=&B915:bc=0:GOSUB 8000:v=PEEK(&8225):m=2:IF v=0 THEN m=0 ELSE IF v=1 THEN m=1
20 sb=&B100:IF m=0 THEN sb=&B8E4
30 PRINT "model version ";v;" state ";HEX$(sb,4)
40 FOR k=1 TO 4:READ a0(k),a1(k),a2(k):NEXT
50 ea=a0(1):IF m=1 THEN ea=a1(1) ELSE IF m=2 THEN ea=a2(1)
60 es=a0(2):IF m=1 THEN es=a1(2) ELSE IF m=2 THEN es=a2(2)
70 FOR t=0 TO 4:READ ra:e=ea:GOSUB 8000
80 PRINT "A=";HEX$(ra,2);" flag ";HEX$(PEEK(sb+19),2);" regs ";:ad=&8220:n=12:GOSUB 8100:PRINT:NEXT
90 FOR t=0 TO 1:READ ra:e=ea:GOSUB 8000
100 POKE &8100,0:POKE &8101,0:POKE &8102,0:POKE &8103,&34:POKE &8104,&87
110 ra=0:e=es:GOSUB 8000
120 PRINT "entry sin(90) flag ";HEX$(PEEK(sb+19),2);" ";:ad=&8100:n=5:GOSUB 8100:PRINT:NEXT
130 DEG:PRINT "BASIC DEG flag ";HEX$(PEEK(sb+19),2);:RAD:PRINT " RAD flag ";HEX$(PEEK(sb+19),2)
140 DEG:y!=SIN(90):PRINT "BASIC SIN(90) DEG ";:FOR k=0 TO 4:PRINT RIGHT$("0"+HEX$(PEEK(@y!+k)),2);:NEXT:PRINT
150 RAD:y!=SIN(90):PRINT "BASIC SIN(90) RAD ";:FOR k=0 TO 4:PRINT RIGHT$("0"+HEX$(PEEK(@y!+k)),2);:NEXT:PRINT
160 END
