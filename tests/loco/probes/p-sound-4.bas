10 REM L4-SOUND probe: records every call BASIC makes to the firmware sound manager
20 REM (SOUND QUEUE, SOUND RELEASE, SOUND AMPL ENVELOPE, SOUND TONE ENVELOPE) and prints
30 REM tag, A and the first bytes at HL. Tags: 1 queue, 2 release, 3 ENV, 4 ENT.
40 DATA &E5,&D5,&C5,&ED,&5B,&F0,&98,&12,&13,&3A,&F2,&98,&12,&13,&01,&10,&00,&ED,&B0,&ED,&53,&F0,&98,&C1,&D1,&E1,&C9
50 FOR i=0 TO 26:READ b:POKE &9880+i,b:NEXT
60 POKE &98F0,0:POKE &98F1,&99
70 FOR k=0 TO 3
80 READ e:READ t
90 s=16*k
100 lo=PEEK(e+1):hi=PEEK(e+2)
110 a=&9800+s:POKE a,&32:POKE a+1,&F2:POKE a+2,&98:POKE a+3,&3E:POKE a+4,t
120 POKE a+5,&CD:POKE a+6,&80:POKE a+7,&98:POKE a+8,&3A:POKE a+9,&F2:POKE a+10,&98
130 POKE a+11,&CF:POKE a+12,lo:POKE a+13,hi
140 POKE e,&C3:POKE e+1,s:POKE e+2,&98
150 NEXT
160 DATA &BCAA,1,&BCB3,2,&BCBC,3,&BCBF,4
170 GOSUB 1000:GOSUB 2000:END
1000 ENV 1
1010 ENT 2
1020 ENV 15,0,0,0,0,0,0
1030 RELEASE 0
1040 RELEASE 7
1050 SOUND 0,100,1
1060 SOUND 255,0,1,0
1070 RETURN
2000 n=(PEEK(&98F0)+256*PEEK(&98F1)-39168)/18
2010 FOR r=0 TO n-1:p=39168+18*r
2020 s$="":FOR j=0 TO 8:s$=s$+HEX$(PEEK(p+j),2)+" ":NEXT:PRINT s$;
2030 s$="":FOR j=9 TO 17:s$=s$+HEX$(PEEK(p+j),2)+" ":NEXT:PRINT s$
2040 NEXT
2050 RETURN
