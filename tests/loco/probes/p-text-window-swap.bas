10 MODE 1:ON ERROR GOTO 1000
20 WINDOW #1,1,20,1,5
30 WINDOW #2,21,40,1,5
40 PEN #1,2:PEN #2,3
50 PRINT #1,"one":PRINT #2,"two"
60 WINDOW SWAP 1,2
70 PRINT #1,"ONE":PRINT #2,"TWO"
80 WINDOW SWAP 1
90 PRINT "zero":PRINT #1,"X":PRINT #2,"Y"
100 PRINT POS(#0);VPOS(#0);POS(#1);VPOS(#1);POS(#2);VPOS(#2)
110 ZONE 0:PRINT ERR
120 ZONE 256:PRINT ERR
130 ZONE 255:PRINT 1,2
140 ZONE 1:PRINT 1,2
150 ZONE 5:PRINT 1,2,3
160 CLS #2
170 PAPER #1,3:CLS #1
180 PEN 1:PAPER 0
190 END
1000 PRINT "err";ERR;"line";ERL
1010 RESUME NEXT
