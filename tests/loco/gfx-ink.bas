10 REM GRAPHICS PEN and PAPER, the ink modes of PLOT and DRAW, MASK, FILL: CPC664/6128 BASIC 1.1 (a 464 prints one line)
20 IF PEEK(&BD46)<>&CF THEN PRINT "needs BASIC 1.1": END
30 MODE 1
40 GRAPHICS PEN 2: GRAPHICS PAPER 3: CLG: PRINT TEST(1,1);TEST(400,300)
50 PLOT 100,100: PRINT TEST(100,100)
60 PLOT 100,100,2,1: PRINT TEST(100,100)
70 PLOT 100,100,1: PRINT TEST(100,100)
80 PLOT 102,100,2: PRINT TEST(102,100)
90 PLOT 102,100,3,2: PRINT TEST(102,100)
100 PLOT 104,100,3,3: PRINT TEST(104,100)
110 PLOT 106,100,1,0: PRINT TEST(106,100)
120 PLOT 108,100: PRINT TEST(108,100)
130 PLOT 110,100,2,3: PRINT TEST(110,100)
140 PLOTR 2,0,1,1: PRINT TEST(112,100)
150 MOVE 100,120,2,0: DRAW 300,120: DRAWR 0,10,1,1: DRAWR -10,0,3,2: PRINT XPOS;YPOS
160 PRINT TEST(200,120);TEST(300,125);TEST(295,130)
170 MASK 15: MOVE 20,200: DRAW 100,200,2: PRINT TEST(20,200);TEST(26,200);TEST(32,200);TEST(40,200);TEST(60,200)
180 MASK 255,0: MOVE 20,210: DRAW 100,210,1: PRINT TEST(20,210);TEST(22,210)
190 MASK 255,1: MOVE 20,220: DRAW 100,220,1: PRINT TEST(20,220);TEST(22,220)
200 MASK 128: MOVE 20,230: GRAPHICS PAPER 0: GRAPHICS PEN 2,0: DRAW 100,230: PRINT TEST(20,230);TEST(22,230);TEST(36,230)
210 MASK 255: GRAPHICS PEN 2,1: MOVE 20,240: DRAW 100,240: PRINT TEST(20,240);TEST(22,240)
220 CLG 0: GRAPHICS PEN 1,0: MASK 255,1: MOVE 0,0,1,0
230 MOVE 400,100: DRAW 500,100: DRAW 500,200: DRAW 400,200: DRAW 400,100
240 MOVE 450,150: FILL 2: PRINT TEST(450,150);TEST(410,110);TEST(401,101);TEST(500,200);TEST(520,150);TEST(350,150)
250 MOVE 600,300: DRAW 560,380: DRAW 620,380: DRAW 600,300
260 MOVE 600,350: GRAPHICS PEN 3: FILL 1: PRINT TEST(600,350);TEST(600,300);TEST(560,380)
270 LOCATE 1,25: PRINT "ink done";
