5 REM LOCO: cap32
10 ON ERROR GOTO 900
20 SAVE "B1",B,&C000,16
30 OPENOUT "T9":PRINT #9,"K":CLOSEOUT
40 OPENIN "T9":LOAD "B1",&C000:PRINT "L";:LINE INPUT #9,A$:PRINT A$
50 PRINT:OPENOUT "T0":PRINT #9,"X":LOAD "B1",&C000:PRINT "M";:PRINT #9,"Z"
60 PRINT:OPENOUT "T1":PRINT #9,"ok":CLOSEOUT:PRINT "again"
70 OPENIN "T9":SAVE "B2",B,&C000,16:PRINT "S";:LINE INPUT #9,A$:PRINT A$
80 PRINT:OPENOUT "T2":PRINT #9,"Y":SAVE "B3",B,&C000,16:PRINT "O";:PRINT #9,"Z"
90 PRINT:OPENIN "T1":LINE INPUT #9,A$:PRINT A$;:CLOSEIN
100 PRINT:OPENIN "T9":LINE INPUT #9,A$:PRINT A$;:CLOSEIN
150 END
900 PRINT " ERR";ERR;"LINE";ERL:RESUME NEXT
