10 REM LOCO: shot
20 REM PLOT, DRAW, MOVE and their relative forms, TEST, TESTR, XPOS, YPOS, in Locomotive's 640 x 400 units
30 MODE 1: INK 2,12: INK 3,18: INK 0,2,2
40 PRINT XPOS;YPOS
50 PLOT 101,51: PRINT XPOS;YPOS;TEST(101,51);TEST(100,50);TEST(102,52);TEST(103,51)
60 MOVE 300,200: PLOT 301,201,2: PRINT TEST(300,200);TEST(301,200);TEST(302,200);TEST(300,198);TEST(300,201)
70 DRAW 400,300: PRINT XPOS;YPOS
80 MOVER -50,-50: PRINT XPOS;YPOS;TESTR(0,0);TESTR(1,1);XPOS;YPOS
90 PLOTR 10,10,3: PRINT XPOS;YPOS;TEST(360,260)
100 DRAWR 20,-5: PRINT XPOS;YPOS
110 PRINT "off"; TEST(-1,0);TEST(0,-1);TEST(640,0);TEST(0,400);TEST(639,399)
115 PRINT "a";: CLG 0: PRINT "b";XPOS;YPOS;TEST(5,5);TEST(101,51)
116 PLOT 5,5,1: CLG 2: PRINT TEST(5,5);XPOS;YPOS;: CLG 0
120 MODE 0: PLOT 10,10,5: PRINT TEST(10,10);TEST(11,10);TEST(12,10);TEST(8,10);TEST(7,10);TEST(10,12);TEST(10,11)
130 MODE 2: PLOT 10,10,1: PRINT TEST(10,10);TEST(11,10);TEST(9,10);TEST(10,11);TEST(10,12);TEST(10,9)
140 MODE 1
150 FOR i=0 TO 7: PLOT 20+i*8+(i AND 1),20+i*3: NEXT
160 MOVE 10,100: DRAW 630,100,2: DRAW 630,390,3: DRAW 10,390,1: DRAW 10,100,2
170 MOVE 30,120: DRAW 600,370,3
180 MOVE 600,120: DRAW 31,371,1
190 MOVE 320,110: DRAW 321,380,2: MOVE 322,110: DRAW 322,380,3
200 MOVE 40,130: DRAW 590,131,1: MOVE 40,134: DRAW 589,135,2
210 MOVE 0,0: DRAW 639,399,1: MOVE 639,0: DRAW 0,399,3
220 MOVE 100,50: DRAW 700,60,2: DRAW -50,300,3: DRAW 100,450,1
230 MOVE 400,20: DRAWR 3,0,2: DRAWR 0,3: DRAWR -3,0: DRAWR 0,-3: DRAWR 7,7,1
240 PRINT XPOS;YPOS
245 ORIGIN 500,300: MOVE 0,0: DRAW 100,60,1: DRAW -40,50,2: PRINT XPOS;YPOS;TEST(0,0);TEST(100,60);TEST(-40,50)
246 PLOT -499,-299,3: PLOTR 4,4: PRINT XPOS;YPOS: ORIGIN 0,0
250 LOCATE 1,25: PRINT "graphics done";
