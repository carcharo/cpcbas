REM Conformance: the asset pipeline (tools/img2cpc.py, tools/tmx2bas.py) end
REM to end. The includes under assets/ were generated from PNG/TMX sources
REM (tools/build_assets.sh); this draws them with the library and checks the
REM screen bytes (PeekScreen) against values worked out here, from the pixel
REM formulas the sources were drawn with (assets/make_sources.py) and the
REM hardware's pixel-to-bit layout -- not from the generated bytes -- plus
REM the tile map arrays, the constants and the palette arrays.
REM
REM Pixel patterns (x, y in pixels of the source image):
REM   plain sprite   pen (x + k*y) AND (npens-1), k = 2 (mode 1), 3 (mode 0)
REM   masked sprite  transparent where x+y is even, else 1 + (x+2*y) MOD (npens-1)
REM   picture        cell (cx, cy) shows kind (cx + 2*cy) MOD 3 = tile 0..2, whose
REM                  pixel (x, y) has pen ((kind+1)*x + y) AND 3
REM Only failures are listed; the passes are counted.
REM
REM Ported from cpcbuild. Changed with the language: $XX is &XX, bAND/bOR/bXOR are AND/OR/XOR,
REM STR$ is N$/T$ (Locomotive puts a space before a number that is not negative), CHR$ 13 is
REM CHR$(13). the parameters MODE and PEN are md and penNo; CHK is lib/chkbuf.bas.

#include <cpc.bas>
#include <cpcbuild/display.bas>
#include <cpcbuild/sprites.bas>
#include <cpcbuild/tiles.bas>
#include "assets/spr1.bas"
#include "assets/msk1.bas"
#include "assets/pic1.bas"
#include "assets/level.bas"
#include "assets/spr0.bas"
#include "assets/msk0.bas"

#include "lib/chkbuf.bas"

SUB ClearScr
  ASM
  ld hl, $C000
  ld de, $C001
  ld bc, $3FFF
  ld (hl), 0
  ldir
  END ASM
END SUB

REM The screen bits of pixel n (0 = leftmost) of a byte, in pen `pen`.
FUNCTION Enc(md AS UBYTE, n AS UBYTE, penNo AS UBYTE) AS UBYTE
  DIM v AS UBYTE
  v = ((penNo AND 1) << (7 - n)) OR (((penNo >> 1) AND 1) << (3 - n))
  IF md = 0 THEN
    v = v OR (((penNo >> 2) AND 1) << (5 - n)) OR (((penNo >> 3) AND 1) << (1 - n))
  END IF
  RETURN v
END FUNCTION

FUNCTION PlainPen(md AS UBYTE, px AS UBYTE, py AS UBYTE) AS UBYTE
  IF md = 0 THEN RETURN (px + 3 * py) AND 15
  RETURN (px + 2 * py) AND 3
END FUNCTION

REM 255 = transparent
FUNCTION MaskPen(md AS UBYTE, px AS UBYTE, py AS UBYTE) AS UBYTE
  IF ((px + py) AND 1) = 0 THEN RETURN 255
  IF md = 0 THEN RETURN 1 + (px + 2 * py) MOD 15
  RETURN 1 + (px + 2 * py) MOD 3
END FUNCTION

CONST BG AS UBYTE = &A5

SUB FillBg(x0 AS UBYTE, y0 AS UBYTE, wb AS UBYTE, h AS UBYTE)
  DIM r, b AS UBYTE
  FOR r = 0 TO h - 1
    FOR b = 0 TO wb - 1
      PokeScreen(x0 + b, y0 + r, BG)
    NEXT b
  NEXT r
END SUB

REM Bytes of the wb x h block at (x0, y0) that differ from the pattern.
FUNCTION SprBad(md AS UBYTE, x0 AS UBYTE, y0 AS UBYTE, wb AS UBYTE, h AS UBYTE, masked AS UBYTE) AS UINTEGER
  DIM r, b, n, ppb, p, pix, msk, want AS UBYTE
  DIM bad AS UINTEGER = 0
  ppb = 4
  IF md = 0 THEN ppb = 2
  FOR r = 0 TO h - 1
    FOR b = 0 TO wb - 1
      pix = 0
      msk = 0
      FOR n = 0 TO ppb - 1
        IF masked THEN
          p = MaskPen(md, b * ppb + n, r)
          IF p = 255 THEN
            msk = msk OR Enc(md, n, 255)
          ELSE
            pix = pix OR Enc(md, n, p)
          END IF
        ELSE
          pix = pix OR Enc(md, n, PlainPen(md, b * ppb + n, r))
        END IF
      NEXT n
      IF masked THEN
        want = (BG AND msk) OR pix
      ELSE
        want = pix
      END IF
      IF PeekScreen(x0 + b, y0 + r) <> want THEN bad = bad + 1
    NEXT b
  NEXT r
  RETURN bad
END FUNCTION

REM Bytes of the 4 x 2 cell picture at tile cell (ox, oy) (mode 1) that differ.
FUNCTION PicBad(ox AS UBYTE, oy AS UBYTE) AS UINTEGER
  DIM cx, cy, r, b, n, k, v AS UBYTE
  DIM bad AS UINTEGER = 0
  FOR cy = 0 TO 1
    FOR cx = 0 TO 3
      k = (cx + 2 * cy) MOD 3
      FOR r = 0 TO 7
        FOR b = 0 TO 1
          v = 0
          FOR n = 0 TO 3
            v = v OR Enc(1, n, ((k + 1) * (b * 4 + n) + r) AND 3)
          NEXT n
          IF PeekScreen((ox + cx) * 2 + b, (oy + cy) * 8 + r) <> v THEN bad = bad + 1
        NEXT b
      NEXT r
    NEXT cx
  NEXT cy
  RETURN bad
END FUNCTION

DIM expPal1(3) AS UBYTE => {0, 26, 6, 18}

REM --- mode 1 ---
Mode 1
ScreenInit()
ClearScr()

CHK("spr1_consts", N$(a_spr1_W) + "," + N$(a_spr1_H) + "," + N$(a_spr1_FRAMES) + "," + N$(a_spr1_SIZE), "2,4,1,8")
CHK("msk1_consts", N$(a_msk1_W) + "," + N$(a_msk1_H) + "," + N$(a_msk1_FRAMES) + "," + N$(a_msk1_SIZE), "2,4,1,16")
CHK("pic_consts", N$(a_pic_COUNT) + "," + N$(a_pic_MAPW) + "," + N$(a_pic_MAPH), "3,4,2")
CHK("map_consts", N$(a_map_W) + "," + N$(a_map_H), "4,2")

PutSprite(10, 20, a_spr1_W, a_spr1_H, @a_spr1(0))
CHK("m1_sprite", N$(SprBad(1, 10, 20, 2, 4, 0)), "0")
CHK("m1_sprite_left_edge", N$(PeekScreen(9, 20)), "0")
CHK("m1_sprite_right_edge", N$(PeekScreen(12, 23)), "0")

FillBg(30, 40, 2, 4)
PutSpriteMasked(30, 40, a_msk1_W, a_msk1_H, @a_msk1(0))
CHK("m1_masked", N$(SprBad(1, 30, 40, 2, 4, 1)), "0")
CHK("m1_masked_left_edge", N$(PeekScreen(29, 40)), "0")

SetTileSet(@a_pic(0))
TileMap(@a_pic_MAP(0), 10, 12, a_pic_MAPW, a_pic_MAPH)
CHK("m1_pic_map", N$(PicBad(10, 12)), "0")
TileMap(@a_map(0), 3, 5, a_map_W, a_map_H)
CHK("m1_tmx_map", N$(PicBad(3, 5)), "0")

DIM i AS UBYTE
DIM bad AS UBYTE = 0
FOR i = 0 TO 7
  IF a_map(i) <> (i MOD 4 + 2 * (i / 4)) MOD 3 THEN bad = bad + 1
  IF a_pic_MAP(i) <> (i MOD 4 + 2 * (i / 4)) MOD 3 THEN bad = bad + 1
NEXT i
CHK("map_arrays", N$(bad), "0")

bad = 0
FOR i = 0 TO 3
  IF a_spr1_pal(i) <> expPal1(i) THEN bad = bad + 1
  IF a_msk1_pal(i) <> expPal1(i) THEN bad = bad + 1
  IF a_pic_pal(i) <> expPal1(i) THEN bad = bad + 1
NEXT i
CHK("m1_palettes", N$(bad), "0")
CHK("m1_pens", N$(a_spr1_PENS) + "," + N$(a_msk1_PENS) + "," + N$(a_pic_PENS), "4,4,4")

REM --- mode 0 ---
Mode 0
ScreenInit()
ClearScr()
CHK("spr0_consts", N$(a_spr0_W) + "," + N$(a_spr0_H) + "," + N$(a_spr0_FRAMES) + "," + N$(a_spr0_SIZE), "8,4,1,32")
CHK("msk0_consts", N$(a_msk0_W) + "," + N$(a_msk0_H) + "," + N$(a_msk0_FRAMES) + "," + N$(a_msk0_SIZE), "4,4,1,32")

PutSprite(5, 10, a_spr0_W, a_spr0_H, @a_spr0(0))
CHK("m0_sprite", N$(SprBad(0, 5, 10, 8, 4, 0)), "0")
CHK("m0_sprite_edges", N$(PeekScreen(4, 10)) + "," + N$(PeekScreen(13, 13)), "0,0")

FillBg(20, 50, 4, 4)
PutSpriteMasked(20, 50, a_msk0_W, a_msk0_H, @a_msk0(0))
CHK("m0_masked", N$(SprBad(0, 20, 50, 4, 4, 1)), "0")

REM pens 0-15 are firmware colours (7 * pen) MOD 27, in pen order
bad = 0
FOR i = 0 TO 15
  IF a_spr0_pal(i) <> (i * 7) MOD 27 THEN bad = bad + 1
  IF a_msk0_pal(i) <> (i * 7) MOD 27 THEN bad = bad + 1
NEXT i
CHK("m0_palettes", N$(bad), "0")
CHK("m0_pens", N$(a_spr0_PENS) + "," + N$(a_msk0_PENS), "16,16")

Mode 1
ScreenInit()
CLS
PRINT AT 0, 0;
Report()
PRINT "DONE"
END
